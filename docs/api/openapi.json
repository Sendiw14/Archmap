{
  "openapi": "3.1.0",
  "info": {
    "title": "ARCHMAP hosted API",
    "version": "1.0.0",
    "description": "Analyze public GitHub repositories. Edges point from the importing module to the imported module. Results expire after the retention period. Cancel/delete require the per-analysis HttpOnly management cookie issued to the creator; state-changing requests must be same-origin."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "components": {
    "schemas": {
      "CreateAnalysisRequest": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "repository": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "ref": {
            "type": "string",
            "pattern": "^(?!-)(?!.*\\.\\.)(?!.*\\/\\/)[A-Za-z0-9._\\/-]{1,200}$"
          }
        },
        "required": ["repository"],
        "additionalProperties": false
      },
      "CreateAnalysisResponse": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "analysis": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              },
              "repository": {
                "type": "object",
                "properties": {
                  "owner": {
                    "type": "string"
                  },
                  "repo": {
                    "type": "string"
                  },
                  "url": {
                    "type": "string",
                    "format": "uri"
                  }
                },
                "required": ["owner", "repo", "url"],
                "additionalProperties": false
              },
              "ref": {
                "type": ["string", "null"]
              },
              "commit": {
                "type": "string",
                "pattern": "^[0-9a-f]{40}$"
              },
              "status": {
                "type": "string",
                "enum": [
                  "queued",
                  "fetching",
                  "analyzing",
                  "persisting",
                  "completed",
                  "completed_with_limitations",
                  "failed",
                  "cancelled",
                  "expired"
                ]
              },
              "error": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "code": {
                        "type": "string",
                        "enum": [
                          "repository_not_found",
                          "repository_not_public",
                          "ref_not_found",
                          "github_unavailable",
                          "limit_exceeded",
                          "analysis_timeout",
                          "internal"
                        ]
                      },
                      "message": {
                        "type": "string"
                      }
                    },
                    "required": ["code", "message"],
                    "additionalProperties": false
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "analyzerVersion": {
                "type": "string"
              },
              "schemaVersion": {
                "type": "string"
              },
              "stats": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "files": {
                        "type": "integer",
                        "minimum": -9007199254740991,
                        "maximum": 9007199254740991
                      },
                      "edges": {
                        "type": "integer",
                        "minimum": -9007199254740991,
                        "maximum": 9007199254740991
                      },
                      "findings": {
                        "type": "integer",
                        "minimum": -9007199254740991,
                        "maximum": 9007199254740991
                      }
                    },
                    "required": ["files", "edges", "findings"],
                    "additionalProperties": false
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "createdAt": {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
              },
              "updatedAt": {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
              },
              "expiresAt": {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
              }
            },
            "required": [
              "id",
              "repository",
              "ref",
              "commit",
              "status",
              "error",
              "analyzerVersion",
              "schemaVersion",
              "stats",
              "createdAt",
              "updatedAt",
              "expiresAt"
            ],
            "additionalProperties": false
          },
          "reused": {
            "type": "boolean"
          },
          "canManage": {
            "type": "boolean"
          }
        },
        "required": ["analysis", "reused", "canManage"],
        "additionalProperties": false
      },
      "AnalysisSummary": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "repository": {
            "type": "object",
            "properties": {
              "owner": {
                "type": "string"
              },
              "repo": {
                "type": "string"
              },
              "url": {
                "type": "string",
                "format": "uri"
              }
            },
            "required": ["owner", "repo", "url"],
            "additionalProperties": false
          },
          "ref": {
            "type": ["string", "null"]
          },
          "commit": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "status": {
            "type": "string",
            "enum": [
              "queued",
              "fetching",
              "analyzing",
              "persisting",
              "completed",
              "completed_with_limitations",
              "failed",
              "cancelled",
              "expired"
            ]
          },
          "error": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "code": {
                    "type": "string",
                    "enum": [
                      "repository_not_found",
                      "repository_not_public",
                      "ref_not_found",
                      "github_unavailable",
                      "limit_exceeded",
                      "analysis_timeout",
                      "internal"
                    ]
                  },
                  "message": {
                    "type": "string"
                  }
                },
                "required": ["code", "message"],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "analyzerVersion": {
            "type": "string"
          },
          "schemaVersion": {
            "type": "string"
          },
          "stats": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "files": {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  },
                  "edges": {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  },
                  "findings": {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  }
                },
                "required": ["files", "edges", "findings"],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          }
        },
        "required": [
          "id",
          "repository",
          "ref",
          "commit",
          "status",
          "error",
          "analyzerVersion",
          "schemaVersion",
          "stats",
          "createdAt",
          "updatedAt",
          "expiresAt"
        ],
        "additionalProperties": false
      },
      "ApiError": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "invalid_request",
                  "invalid_repository",
                  "unsupported_provider",
                  "repository_not_found",
                  "repository_not_public",
                  "ref_not_found",
                  "rate_limited",
                  "github_unavailable",
                  "imports_disabled",
                  "queue_full",
                  "not_found",
                  "expired",
                  "not_ready",
                  "unauthorized",
                  "conflict",
                  "limit_exceeded",
                  "analysis_timeout",
                  "internal"
                ]
              },
              "message": {
                "type": "string"
              }
            },
            "required": ["code", "message"],
            "additionalProperties": false
          }
        },
        "required": ["error"],
        "additionalProperties": false
      },
      "Graph": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "metadata": {
            "type": "object",
            "properties": {
              "analysisId": {
                "type": "string"
              },
              "schemaVersion": {
                "type": "string"
              },
              "analyzerVersion": {
                "type": "string"
              },
              "compilerVersion": {
                "type": "string"
              },
              "repository": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "commit": {
                    "type": ["string", "null"]
                  }
                },
                "required": ["name", "commit"],
                "additionalProperties": false
              },
              "configHash": {
                "type": "string"
              },
              "status": {
                "type": "string",
                "enum": ["completed", "completed_with_limitations", "failed"]
              },
              "generatedAt": {
                "type": ["string", "null"]
              },
              "counts": {
                "type": "object",
                "properties": {
                  "filesDiscovered": {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  },
                  "filesAnalyzed": {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  },
                  "filesExcluded": {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  },
                  "filesSkipped": {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  }
                },
                "required": ["filesDiscovered", "filesAnalyzed", "filesExcluded", "filesSkipped"],
                "additionalProperties": false
              }
            },
            "required": [
              "analysisId",
              "schemaVersion",
              "analyzerVersion",
              "compilerVersion",
              "repository",
              "configHash",
              "status",
              "generatedAt",
              "counts"
            ],
            "additionalProperties": false
          },
          "nodes": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "kind": {
                  "type": "string",
                  "enum": ["file", "external", "builtin"]
                },
                "path": {
                  "type": "string"
                },
                "displayName": {
                  "type": "string"
                },
                "package": {
                  "type": ["string", "null"]
                },
                "language": {
                  "anyOf": [
                    {
                      "type": "string",
                      "enum": ["ts", "tsx", "mts", "cts", "dts", "js", "jsx", "mjs", "cjs", "json"]
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": ["id", "kind", "path", "displayName", "package", "language"],
              "additionalProperties": false
            }
          },
          "edges": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "source": {
                  "type": "string"
                },
                "target": {
                  "type": ["string", "null"]
                },
                "specifier": {
                  "type": "string"
                },
                "importKind": {
                  "type": "string",
                  "enum": ["import", "export", "require", "dynamic-import", "import-type"]
                },
                "dependencyClass": {
                  "type": "string",
                  "enum": ["runtime", "type-only"]
                },
                "resolution": {
                  "type": "string",
                  "enum": ["resolved", "external", "unresolved"]
                },
                "evidence": {
                  "type": "object",
                  "properties": {
                    "file": {
                      "type": "string"
                    },
                    "line": {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    },
                    "column": {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    },
                    "text": {
                      "type": "string"
                    }
                  },
                  "required": ["file", "line", "column", "text"],
                  "additionalProperties": false
                },
                "diagnostic": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "source",
                "target",
                "specifier",
                "importKind",
                "dependencyClass",
                "resolution",
                "evidence"
              ],
              "additionalProperties": false
            }
          },
          "findings": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "category": {
                  "type": "string",
                  "enum": ["runtime-cycle", "type-cycle", "hotspot", "unresolved"]
                },
                "severity": {
                  "type": "string",
                  "enum": ["error", "warning", "info"]
                },
                "nodes": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "evidence": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "explanation": {
                  "type": "string"
                },
                "rule": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "category",
                "severity",
                "nodes",
                "evidence",
                "explanation",
                "rule"
              ],
              "additionalProperties": false
            }
          },
          "diagnostics": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "code": {
                  "type": "string"
                },
                "severity": {
                  "type": "string",
                  "enum": ["error", "warning", "info"]
                },
                "message": {
                  "type": "string"
                },
                "location": {
                  "type": "object",
                  "properties": {
                    "file": {
                      "type": "string"
                    },
                    "line": {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    },
                    "column": {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    }
                  },
                  "required": ["file", "line", "column"],
                  "additionalProperties": false
                },
                "file": {
                  "type": "string"
                }
              },
              "required": ["code", "severity", "message"],
              "additionalProperties": false
            }
          },
          "coverage": {
            "type": "object",
            "properties": {
              "supportedConstructs": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "importKinds": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                }
              },
              "resolutions": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                }
              },
              "unsupportedExpressions": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "filesWithParseErrors": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "supportedConstructs",
              "importKinds",
              "resolutions",
              "unsupportedExpressions",
              "filesWithParseErrors"
            ],
            "additionalProperties": false
          }
        },
        "required": ["metadata", "nodes", "edges", "findings", "diagnostics", "coverage"],
        "additionalProperties": false
      },
      "FindingsResponse": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "findings": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "category": {
                  "type": "string",
                  "enum": ["runtime-cycle", "type-cycle", "hotspot", "unresolved"]
                },
                "severity": {
                  "type": "string",
                  "enum": ["error", "warning", "info"]
                },
                "nodes": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "evidence": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "explanation": {
                  "type": "string"
                },
                "rule": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "category",
                "severity",
                "nodes",
                "evidence",
                "explanation",
                "rule"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": ["findings"],
        "additionalProperties": false
      },
      "Health": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": ["ok", "degraded", "unavailable"]
          },
          "checks": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "string",
              "enum": ["ok", "fail"]
            }
          }
        },
        "required": ["status"],
        "additionalProperties": false
      }
    },
    "securitySchemes": {
      "management": {
        "type": "apiKey",
        "in": "cookie",
        "name": "archmap_mgmt_{id}",
        "description": "256-bit per-analysis capability; HttpOnly, SameSite=Strict, path-scoped to the analysis."
      }
    }
  },
  "paths": {
    "/v1/analyses": {
      "post": {
        "summary": "Submit a public GitHub repository for analysis",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateAnalysisRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Existing result for the same commit reused (no management cookie)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateAnalysisResponse"
                }
              }
            }
          },
          "202": {
            "description": "Queued; sets the management cookie",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateAnalysisResponse"
                }
              }
            }
          },
          "400": {
            "description": "`invalid_request`, `invalid_repository`, `unsupported_provider`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "401": {
            "description": "Cross-origin request (`unauthorized`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "403": {
            "description": "`repository_not_public`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "404": {
            "description": "`repository_not_found`, `ref_not_found`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "429": {
            "description": "`rate_limited` (see Retry-After)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "503": {
